# Polymarket Trading Bot Environment Variables

# Polymarket API Configuration
# Note: For read-only data access, no authentication is required
# For actual trading, you'll need:
# POLYMARKET_API_KEY=your_api_key_here
# POLYMARKET_API_SECRET=your_api_secret_here
# POLYMARKET_WALLET_ADDRESS=your_wallet_address_here
# POLYMARKET_PRIVATE_KEY=your_private_key_here

# Bot Configuration
DRY_RUN=true  # Set to false to enable live trading
TOTAL_CAPITAL=10000  # Total capital to trade with (USD)

# Logging
LOG_LEVEL=INFO
